# Khana-AI Hosted Database & AI Configuration Template

# Google GenAI / Gemma API Key
GEMMA_API_KEY=your_gemini_or_gemma_api_key_here
GEMINI_API_KEY=your_gemini_or_gemma_api_key_here

# LLM & Vision Model Choice
CHAT_MODEL=gemma-4-31b-it
VISION_MODEL=gemma-4-31b-it

# Centralized Hosted MySQL Database Configuration
# When DB_TYPE=mysql, profiles, planner items, and diet history are stored
# on the hosted server and instantly shared across all computers!
DB_TYPE=mysql
MYSQL_HOST=your-hosted-mysql-domain-or-ip.com
MYSQL_PORT=3306
MYSQL_USER=khana_user
MYSQL_PASSWORD=your_secure_password
MYSQL_DATABASE=khana_ai
# Or provide a single connection string:
# DATABASE_URL=mysql://khana_user:your_secure_password@your-hosted-mysql-domain.com:3306/khana_ai
